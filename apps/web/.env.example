# Bolt Database (Supabase-compatible API from Bolt.new)
VITE_BOLT_DATABASE_URL=
VITE_BOLT_DATABASE_ANON_KEY=
VITE_BOLT_STORAGE_BUCKET=event-photos

# Legacy aliases (also supported)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# PicShareNow assistant (browser — set in Bolt secrets for production)
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash-lite
VITE_GEMINI_THINKING_LEVEL=low
VITE_GEMINI_MAX_OUTPUT_TOKENS=900
