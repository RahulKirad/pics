# Application
NODE_ENV=development
PORT=3001
WEB_PORT=5173

# Database
DATABASE_URL=mysql://photoplatform:photoplatform@localhost:3306/photo_platform

# Redis
REDIS_URL=redis://localhost:6379

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=photo_platform_faces

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-in-production-use-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Storage
STORAGE_DRIVER=vps
STORAGE_ROOT=/data/photo-platform
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=photo-platform
S3_ACCESS_KEY=
S3_SECRET_KEY=
CDN_URL=

# AI Service (internal only)
AI_SERVICE_URL=http://localhost:8000

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (future)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Super Admin (optional — used by db:seed)
SUPER_ADMIN_EMAIL=admin@photoflow.local
SUPER_ADMIN_PASSWORD=ChangeMe-SuperAdmin-123!
SENTRY_DSN=

# CORS
CORS_ORIGIN=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173

# PicShareNow in-browser assistant (see apps/web/.env.example)
# Configure VITE_GEMINI_API_KEY in apps/web/.env.local — not committed.

# Upload limits
MAX_FILE_SIZE_MB=50
MAX_UPLOAD_BATCH=100
